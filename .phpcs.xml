<?xml version="1.0"?>
<ruleset name="Sec-Fetch CSRF">
	<description>WordPress coding standards for Sec-Fetch CSRF plugin</description>

	<!-- Exclude test files from certain rules -->
	<rule ref="WordPress.Variables.GlobalVariables.OverrideProhibited">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Exclude test files from security escaping rules -->
	<rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Exclude test files from sanitization rules -->
	<rule ref="WordPress.Security.ValidatedInput.InputNotSanitized">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Exclude test files from filename rules -->
	<rule ref="WordPress.Files.Filename">
		<exclude-pattern>tests/</exclude-pattern>
	</rule>
</ruleset>

