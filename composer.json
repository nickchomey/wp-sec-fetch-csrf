{
    "name": "stf/sec-fetch-csrf",
    "description": "Sec-Fetch CSRF Protection for WordPress",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "pestphp/pest": "^2.0",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "guzzlehttp/guzzle": "^7.10",
        "wp-coding-standards/wpcs": "^3.3",
        "phpcsstandards/phpcsutils": "^1.2",
        "phpcsstandards/phpcsextra": "^1.5"
    },
    "autoload": {
    },
    "autoload-dev": {
        "files": [
            "tests/Unit/Helpers.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
